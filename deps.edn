{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        rewrite-clj/rewrite-clj {:mvn/version "1.1.47"}
        hiccup/hiccup {:mvn/version "2.0.0-RC3"}}
 :aliases
 {:test {:extra-paths ["test"]
         :main-opts ["-e" "(require 'sdiff.core-test) (let [{:keys [fail error]} (clojure.test/run-tests 'sdiff.core-test)] (System/exit (if (pos? (+ fail error)) 1 0)))"]}}}
